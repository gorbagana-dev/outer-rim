# Server-side RPCs. The browser talks to /api/rpc/{gorchain|solana} so keys stay here.
GORCHAIN_RPC_URL=https://rpc.gorbagana.wtf
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

GORCHAIN_DOMAIN_ID=1198486093
SOLANA_DOMAIN_ID=1399811149
GORCHAIN_CHAIN_ID=1198486093
SOLANA_CHAIN_ID=1399811149

# From scripts/deploy-core.sh → state/program-ids.json
NEXT_PUBLIC_GORCHAIN_MAILBOX=
NEXT_PUBLIC_SOLANA_MAILBOX=

# From scripts/deploy-warp.sh → warp-deploy-outputs/program-ids.json
NEXT_PUBLIC_GORCHAIN_WARP_PROGRAM=
NEXT_PUBLIC_SOLANA_WARP_PROGRAM=

# Optional message explorer base (link becomes {url}/message/{id})
NEXT_PUBLIC_EXPLORER_URL=

# Optional block explorers
NEXT_PUBLIC_GORCHAIN_EXPLORER=https://scan.gorbagana.wtf
NEXT_PUBLIC_SOLANA_EXPLORER=https://solscan.io
