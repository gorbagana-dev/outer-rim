# --- Images (pin a digest after first pull; do not use :latest) ---
# GHCR images are private (gorbagana-dev). Rebuild from hyperlane-monorepo-audit
# with docker/ if you cannot pull. After pull:
#   docker inspect --format='{{index .RepoDigests 0}}' <image>
HYPERLANE_AGENT_IMAGE=ghcr.io/gorbagana-dev/hyperlane-agent:v2.2.0-gorbagana.1
HYPERLANE_DEPLOYER_IMAGE=ghcr.io/gorbagana-dev/hyperlane-svm-deployer:v2.2.0-gorbagana.4
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_MC_IMAGE=quay.io/minio/mc:RELEASE.2025-08-13T08-35-41Z

# --- Chains ---
GORCHAIN_RPC_URL=https://rpc.gorbagana.wtf
# Operator Helius / Triton / other. Do not commit the API key.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

GORCHAIN_DOMAIN_ID=1198486093
SOLANA_DOMAIN_ID=1399811149
GORCHAIN_CHAIN_ID=1198486093
SOLANA_CHAIN_ID=1399811149
GORCHAIN_IS_TESTNET=false
SOLANA_IS_TESTNET=false

# --- Warp route ---
WARP_ROUTES=gor

# --- Deployer keypair (Solana JSON array). Generate with scripts/generate-keys.sh ---
DEPLOYER_KEYPAIR_FILE=./keys/deployer-keypair.json

# Optional post-deploy ownership transfer (Privy Solana wallet pubkeys).
# Leave empty to keep the deployer as owner (dev only).
BRIDGE_OWNER_PUBKEY=
IGP_ORACLE_PUBKEY=
# Defaults to BRIDGE_OWNER_PUBKEY if empty. Otherwise the deployer remains beneficiary.
IGP_BENEFICIARY_PUBKEY=

# ISM 1-of-1: each chain trusts the *other* chain's validator H160 (secp256k1).
# These are Privy Ethereum wallet addresses, not Solana pubkeys.
GORCHAIN_VALIDATOR_ADDRESS=0x
SOLANA_VALIDATOR_ADDRESS=0x

# --- Privy (KMS proxy). Required for validators. ---
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_API_URL=https://api.privy.io
PRIVY_WALLET_ID_GORCHAIN=
PRIVY_WALLET_ID_SOLANA=

# --- MinIO root (checkpoint buckets). Generate strong values. ---
MINIO_ROOT_USER=outerrim
MINIO_ROOT_PASSWORD=change-me-minio-root

# Per-validator IAM (written by generate-keys.sh into keys/minio-iam.env;
# docker-compose also reads these if set here).
GORCHAIN_PRIMARY_KEY_ID=
GORCHAIN_PRIMARY_SECRET=
SOLANA_PRIMARY_KEY_ID=
SOLANA_PRIMARY_SECRET=

# Redeploy flags (host scripts also accept --force)
FORCE_REDEPLOY=false
CONFIRM_FORCE_REDEPLOY=false
